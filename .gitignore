GoogleService-Info.plist
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
key.properties

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json.example
*.iml

# Windsurf agent kits — only for inspection, not part of project
.agent-kits/

# Personal Cascade memory cache
.windsurf/.cache/

# Cursor MCP local config (contains personal tokens) — commit only .cursor/mcp.example.json
.cursor/mcp.json

# Claude Code MCP local config
.mcp.json
.cursor/.cache/

