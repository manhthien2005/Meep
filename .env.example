# ============================================================================
# Meep — Local development env
# ============================================================================
# Copy this file to `.env` (gitignored) and fill in real values.
# `.env.example` itself is committed; `.env` MUST never be committed.
#
# This file is read by:
#   - apps/mobile/ → via flutter_dotenv (or --dart-define equivalents)
#   - firebase/functions/ → via process.env (loaded by the Firebase emulator)
#   - services/api/ → via process.env (loaded by zod schema in src/config/env.ts)
# ============================================================================

# ---- Firebase project ----
# From: Firebase Console → Project settings → General
FIREBASE_PROJECT_ID=meep-dev
FIREBASE_PROJECT_REGION=asia-southeast1

# ---- Cloud Functions (production runtime — set via Secret Manager, NOT here) ----
# Local development only. In production, use:
#   firebase functions:secrets:set <NAME>
# These placeholders document which secrets the Functions code expects.
#
# FCM_SERVER_KEY=<set-via-secret-manager>
# CRASHLYTICS_API_TOKEN=<set-via-secret-manager>

# ---- Optional standalone backend (services/api/) ----
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Path to a downloaded service-account JSON for local Admin SDK.
# Do NOT commit the actual JSON — it's in .gitignore.
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-adminsdk.json

# ---- 3rd-party (placeholders only — fill if used) ----
# SENTRY_DSN=
# OPENAI_API_KEY=
